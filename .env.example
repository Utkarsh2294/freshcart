# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://freshcart:freshcart_pass@localhost:5433/freshcart

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay (TEST mode)
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_SECRET

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@freshcart.dev

# Kimi K3 structured recipe generation (OpenRouter-compatible endpoint)
OPENROUTER_API_KEY=
KIMI_MODEL=moonshotai/kimi-k3
KIMI_BASE_URL=https://openrouter.ai/api/v1
KIMI_TIMEOUT_MS=30000

# Phase 2 self-hosted recommendation engine
RECOMMENDATION_SERVICE_URL=http://localhost:8001

# Phase 3 self-hosted input understanding service
INPUT_UNDERSTANDING_SERVICE_URL=http://localhost:8002

# Pramarsha
PRAMARSHA_API_URL=
PRAMARSHA_TIMEOUT_MS=350
MIN_RECOMMENDATION_CONFIDENCE=0.4
WEATHER_SIGNAL_ENABLED=false
EVENT_SIGNAL_ENABLED=false

# Frontend build-time variables
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
VITE_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
VITE_VAPID_PUBLIC_KEY=

# Phase 8 feature flags
FEATURE_SMART_PANTRY=true
FEATURE_HANDS_FREE_COOKING=true
FEATURE_WEEKLY_MEAL_PLANNER=true
FEATURE_NUTRITION_COST_CARD=true
FEATURE_DIETARY_FILTERS=true
FEATURE_SOCIAL_PROOF_GAMIFICATION=true
FEATURE_VOICE_QUICK_ADD=true
FEATURE_PUSH_NOTIFICATIONS_PWA=true
FEATURE_PREDICTIVE_REORDER_FEED=true
FEATURE_REFERRAL_WALLET=true
VITE_FEATURE_SMART_PANTRY=true
VITE_FEATURE_HANDS_FREE_COOKING=true
VITE_FEATURE_WEEKLY_MEAL_PLANNER=true
VITE_FEATURE_NUTRITION_COST_CARD=true
VITE_FEATURE_DIETARY_FILTERS=true
VITE_FEATURE_SOCIAL_PROOF_GAMIFICATION=true
VITE_FEATURE_VOICE_QUICK_ADD=true
VITE_FEATURE_PUSH_NOTIFICATIONS_PWA=true
VITE_FEATURE_PREDICTIVE_REORDER_FEED=true
VITE_FEATURE_REFERRAL_WALLET=true
