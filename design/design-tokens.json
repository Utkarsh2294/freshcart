{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "4.0.0",
  "color": {
    "light": {
      "background": "#F7F8FA",
      "surface": "#FBFBFC",
      "card": "#FFFFFF",
      "navbar": "rgba(255, 255, 255, 0.82)",
      "textPrimary": "#111111",
      "textSecondary": "#6B7280",
      "border": "#ECEEF2",
      "divider": "#F2F4F7"
    },
    "dark": {
      "background": "#08090C",
      "surface": "#111827",
      "card": "#181C26",
      "navbar": "rgba(8, 9, 12, 0.72)",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#A3A3A3",
      "border": "#252A36"
    },
    "brand": {
      "primaryStart": "#6366F1",
      "primaryEnd": "#8B5CF6",
      "accentMiddle": "#EC4899",
      "accentEnd": "#F97316"
    },
    "semantic": {
      "success": "#22C55E",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#3B82F6"
    },
    "pramarsha": {
      "start": "#0F766E",
      "middle": "#14B8A6",
      "end": "#22C55E",
      "usage": "Reserved exclusively for Pramarsha surfaces"
    }
  },
  "typography": {
    "fontFamily": "'Geist', 'Inter', 'SF Pro Display', -apple-system, sans-serif",
    "fontSize": {
      "caption": "12px",
      "small": "14px",
      "body": "16px",
      "cardTitle": "18px",
      "sectionHeading": "24px",
      "pageHeading": "32px",
      "hero": "48px"
    },
    "fontWeight": {
      "medium": 500,
      "semibold": 600
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "14": "56px",
    "16": "64px"
  },
  "layout": {
    "maxWidth": "1440px",
    "desktopPadding": "48px",
    "largeDesktopPadding": "64px",
    "sectionGap": "40px",
    "largeSectionGap": "56px",
    "cardGap": "24px"
  },
  "motion": {
    "fast": "200ms",
    "normal": "250ms",
    "slow": "400ms"
  }
}
